# Copy to .env and fill in. Never commit the real file.
#
# Every value here is referenced from the YAML config as ${NAME}.

# --- Provider credentials ------------------------------------------------
# DigitalOcean: a personal access token with write scope.
DO_TOKEN=

# Vultr: an API key from https://my.vultr.com/settings/#settingsapi
# VULTR_TOKEN=

# Cloudflare: an API token with Zone:DNS:Edit on the relevant zone.
# CF_TOKEN=
# CF_ZONE_ID=

# Azure DNS. Leave the client secret unset when running on Azure: a managed
# identity supplies credentials automatically, which is preferable to a
# long-lived secret. The identity needs the "DNS Zone Contributor" role.
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# AWS Route53. Leave these unset when running on AWS: an instance profile,
# task role or IRSA supplies credentials automatically, which is preferable to
# long-lived keys. The IAM policy needs route53:ListHostedZonesByName,
# route53:ListResourceRecordSets and route53:ChangeResourceRecordSets.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_HOSTED_ZONE_ID=

# --- Client tokens -------------------------------------------------------
# One per host. Generate with: openssl rand -hex 24
HOME_TOKEN=

# --- Runtime -------------------------------------------------------------
# Path to the configuration file. Defaults to ./ddns.yaml when unset.
# DDNS_CONFIG=/etc/ddns/ddns.yaml

# DEBUG, INFO, NOTICE, WARNING, ERROR. Defaults to INFO.
# DDNS_LOG_LEVEL=INFO
