{
    "name": "dmanavi/ddns",
    "description": "Self-hosted dynamic DNS server exposing a simplified API over DigitalOcean, Vultr, Cloudflare and other DNS providers, usable over HTTP or from the CLI.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "ddns",
        "dyndns",
        "dns",
        "digitalocean",
        "vultr",
        "cloudflare",
        "route53",
        "self-hosted"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "aws/aws-sdk-php": "3.390.5",
        "guzzlehttp/guzzle": "7.15.3",
        "monolog/monolog": "3.10.0",
        "php-di/php-di": "7.1.1",
        "psr/http-client": "1.0.3",
        "psr/http-factory": "1.1.0",
        "psr/http-message": "2.0",
        "psr/http-server-middleware": "1.0.2",
        "psr/log": "3.0.2",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.2",
        "symfony/console": "7.4.15",
        "symfony/yaml": "7.4.15",
        "vlucas/phpdotenv": "5.6.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.18",
        "phpstan/phpstan": "2.2.8",
        "phpunit/phpunit": "11.5.56"
    },
    "suggest": {
        "ext-pcntl": "Enables graceful SIGINT/SIGTERM shutdown for the `watch` command."
    },
    "autoload": {
        "psr-4": {
            "Ddns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ddns\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ddns"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false,
        "audit": {
            "abandoned": "report"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "fmt": "php-cs-fixer fix",
        "fmt:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@audit",
            "@fmt:check",
            "@analyse",
            "@test"
        ],
        "audit": "composer audit --locked"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "analyse": "Run PHPStan static analysis at level max.",
        "fmt": "Apply PHP-CS-Fixer formatting.",
        "fmt:check": "Verify formatting without writing changes.",
        "check": "Run the audit, formatting check, static analysis and tests.",
        "audit": "Check locked dependencies against known security advisories."
    }
}
