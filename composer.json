{
    "name": "dmanavi/ddns",
    "description": "Self-hosted dynamic DNS server exposing a simplified API over DigitalOcean, Vultr, Cloudflare and other DNS providers, usable over HTTP or from the CLI.",
    "type": "project",
    "license": "MIT",
    "keywords": ["ddns", "dyndns", "dns", "digitalocean", "vultr", "cloudflare", "route53", "self-hosted"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/console": "^7.1",
        "symfony/yaml": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.3"
    },
    "suggest": {
        "ext-pcntl": "Enables graceful SIGINT/SIGTERM shutdown for the `watch` command."
    },
    "autoload": {
        "psr-4": {
            "Ddns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ddns\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/ddns"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "fmt": "php-cs-fixer fix",
        "fmt:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@fmt:check",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "analyse": "Run PHPStan static analysis at level max.",
        "fmt": "Apply PHP-CS-Fixer formatting.",
        "fmt:check": "Verify formatting without writing changes.",
        "check": "Run formatting check, static analysis and tests."
    }
}
