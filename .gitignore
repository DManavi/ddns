/vendor/
/.php-cs-fixer.cache
/.phpunit.cache/
/.phpunit.result.cache
/composer.lock.bak

# Coverage reports. The badge data generated from them is committed;
# the reports themselves are not.
/build/

# Local runtime configuration and secrets. The configuration is generated -
# by `ddns config:init` or `ddns config:init --sample` - and never committed,
# so that only one file can ever be the one the application reads.
/.env
/.env.local
/config/ddns.yaml

# Editor / OS noise
/.idea/

# Editor config that is worth sharing is committed; anything personal - your
# own settings.json, window layout, extension state - is not.
/.vscode/*
!/.vscode/launch.json
!/.vscode/extensions.json
.DS_Store
*.swp

# An optional local copy of the Swagger UI assets, installed by whoever would
# rather no browser of theirs fetched them from a CDN. Not ours to ship.
/public/vendor/
